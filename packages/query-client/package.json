{
  "name": "@request-xray/query-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc --noEmit false --outDir dist --declaration",
    "generate": "openapi-typescript ../../schemas/collector.openapi.yaml -o src/schema.ts",
    "test": "openapi-typescript ../../schemas/collector.openapi.yaml -o src/schema.ts --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "^5.8.0"
  }
}
