{
  "name": "request-xray-test-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local NestJS multi-service integration lab for Request X-Ray",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node scripts/run-lab.cjs",
    "start:otel": "node scripts/run-lab.cjs --otel",
    "start:xray": "node scripts/run-lab.cjs --xray",
    "smoke": "node --test tests/smoke.test.cjs",
    "scenarios": "node scripts/scenarios.cjs",
    "scenario:checkout": "node scripts/scenarios.cjs checkout",
    "scenario:all": "node scripts/scenarios.cjs all",
    "verify": "npm run typecheck && npm run build && npm run smoke",
    "clean": "node scripts/clean.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
